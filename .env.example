# Copy to .env and fill in your own values. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Enrichment / verification ---
APOLLO_API_KEY=
HUNTER_API_KEY=
BRAVE_API_KEY=
VOYAGE_API_KEY=          # embeddings for voice-matching over sent email

# --- Signal sources (optional) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE=

# --- Slack (human-in-the-loop approval) ---
SLACK_TOKEN=             # xoxp/xoxb with chat:write
SLACK_INBOUND_CHANNEL=   # channel ID for inbound cards
SLACK_OUTBOUND_CHANNEL=  # channel ID for outbound cards

# --- CRM (Salesforce via sf CLI) ---
SF_TARGET_ORG=you@example.com   # sf CLI target-org username

# --- Infra ---
REMOTE_HOST=user@remote-host.example.com   # host that runs scheduled jobs
